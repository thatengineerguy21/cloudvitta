                    "description": "Provisioned IOPS",
                    "type": "integer"
                },
                "multi_az": {
                    "description": "High Availability deployment",
                    "type": "boolean"
                },
                "ram_gb": {
                    "description": "Memory capacity in GiB (0 for pure storage rows)",
                    "type": "number"
                },
                "storage_family": {
                    "description": "\"gp3\", \"gp2\", \"io1\", \"ssd\", \"hdd\"",
                    "type": "string"
                },
                "storage_gb": {
                    "description": "Storage capacity in GiB (0 for pure instance rows)",
