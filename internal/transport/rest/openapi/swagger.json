                },
                "deployment_tier": {
                    "description": "\"standard\", \"flexible\", \"burstable\", \"aurora\"",
                    "type": "string"
                },
                "engine": {
                    "description": "\"postgresql\", \"mysql\", \"sqlserver\", \"mariadb\", \"oracle\"",
