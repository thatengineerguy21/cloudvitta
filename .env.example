# Server Configuration
CLOUDVITTA_SERVER_PORT=8080
CLOUDVITTA_PRIMARY_ENVIRONMENT=development
CLOUDVITTA_PRIMARY_LOG_LEVEL=debug

# Database (Neon Serverless Postgres)
CLOUDVITTA_DATABASE_URL=postgres://user:password@localhost:5432/cloudvitta

# Cache (Upstash Redis)
CLOUDVITTA_REDIS_URL=redis://localhost:6379/0

# Storage (GCS)
CLOUDVITTA_STORAGE_GCS_BUCKET_NAME=cloudvitta-raw-data
